{
  "name": "arch-assistant",
  "displayName": "Arch Assistant",
  "description": "Auto-opens Arch CLI terminal on the right side",
  "version": "0.3.0",
  "publisher": "archide",
  "engines": {
    "vscode": "^1.126.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arch-assistant.openTerminal",
        "title": "Arch: Open CLI Terminal"
      }
    ],
    "keybindings": [
      {
        "command": "arch-assistant.openTerminal",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
