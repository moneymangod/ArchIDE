{
  "name": "arch-assistant",
  "displayName": "Arch Assistant",
  "description": "AI-powered coding assistant powered by ArchCLI",
  "version": "0.1.0",
  "publisher": "archide",
  "engines": {
    "vscode": "^1.130.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arch-assistant",
          "title": "Arch Assistant",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "arch-assistant": [
        {
          "type": "webview",
          "id": "arch-assistant.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "arch-assistant.openChat",
        "title": "Arch: Open Chat"
      },
      {
        "command": "arch-assistant.editWithAI",
        "title": "Arch: Edit with AI"
      },
      {
        "command": "arch-assistant.explainCode",
        "title": "Arch: Explain Code"
      },
      {
        "command": "arch-assistant.fixCode",
        "title": "Arch: Fix Code"
      },
      {
        "command": "arch-assistant.addToChat",
        "title": "Arch: Add to Chat"
      }
    ],
    "keybindings": [
      {
        "command": "arch-assistant.editWithAI",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "arch-assistant.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ],
    "configuration": {
      "title": "Arch Assistant",
      "properties": {
        "arch-assistant.defaultProvider": {
          "type": "string",
          "default": "cloudflare-workers-ai",
          "description": "AI provider to use for chat and edits"
        },
        "arch-assistant.models.chat": {
          "type": "string",
          "default": "@cf/meta/llama-3.3-70b-instruct",
          "description": "Model for chat conversations"
        },
        "arch-assistant.models.edit": {
          "type": "string",
          "default": "@cf/meta/llama-3.3-70b-instruct",
          "description": "Model for code edits"
        },
        "arch-assistant.models.autocomplete": {
          "type": "string",
          "default": "@cf/meta/coderound-3.5",
          "description": "Model for inline autocomplete"
        },
        "arch-assistant.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to ArchCLI binary (optional)"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "arch-assistant.explainCode",
          "when": "editorHasSelection",
          "group": "arch@1"
        },
        {
          "command": "arch-assistant.fixCode",
          "when": "editorHasSelection",
          "group": "arch@2"
        },
        {
          "command": "arch-assistant.addToChat",
          "when": "editorHasSelection",
          "group": "arch@3"
        },
        {
          "command": "arch-assistant.editWithAI",
          "when": "editorHasSelection",
          "group": "arch@4"
        }
      ],
      "editor/title": [
        {
          "command": "arch-assistant.openChat",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "arch-assistant.editWithAI",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
